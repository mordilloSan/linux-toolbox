#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT

pass() {
	printf 'ok - %s\n' "$1"
}

test_installer_orchestration() {
	local root="$test_dir/orchestration" output script
	mkdir -p "$root/bin" "$root/home" "$root/local"
	cat >"$root/bin/mock" <<'EOF'
#!/usr/bin/env bash
case ${0##*/} in
curl)
	url=${!#}
	printf '%s\n' "${url##*/}" >>"$MOCK_CURL_LOG"
	[[ ${url##*/} != "${MOCK_CURL_FAIL:-}" ]] || exit 22
	printf '%s\n' '#!/usr/bin/env bash' 'exit 0'
	;;
sudo) [[ ${1:-} == -v ]] || exec "$@" ;;
esac
EOF
	chmod +x "$root/bin/mock"
	for command in curl sudo git gh jq make go node npm npx codex claude shellcheck shfmt rg actionlint bwrap; do
		ln -s mock "$root/bin/$command"
	done
	printf '%s\n' install-dependencies.sh install-go.sh install-node.sh \
		install-shell-tools.sh install-release-flow.sh install-ai-tools.sh >"$root/expected"

	mkdir -p "$root/home/.local/bin"
	output=$(MOCK_CURL_LOG="$root/remote" PATH="$root/bin:$PATH" HOME="$root/home" \
		LINUX_TOOLBOX_NONINTERACTIVE=1 bash <install.sh)
	grep -Fq 'Setup complete' <<<"$output"
	grep -Fq 'Git identity setup skipped' <<<"$output"
	grep -Fq 'GitHub authentication setup skipped' <<<"$output"
	grep -Fq 'Open a new terminal' <<<"$output"
	diff -u "$root/expected" "$root/remote"

	# A failed download stops the run with a FAILED line, before any later step.
	if output=$(MOCK_CURL_FAIL=install-node.sh MOCK_CURL_LOG="$root/failed" PATH="$root/bin:$PATH" \
		HOME="$root/home" LINUX_TOOLBOX_NONINTERACTIVE=1 bash <install.sh 2>&1); then
		return 1
	fi
	grep -Fq 'Unable to download install-node.sh' <<<"$output"
	[[ $(tail -n 1 "$root/failed") == install-node.sh ]]

	cp install.sh "$root/local/"
	while read -r script; do
		printf '#!/usr/bin/env bash\nprintf "%%s\\n" %q >> %q\n' \
			"$script" "$root/local.log" >"$root/local/$script"
	done <"$root/expected"
	MOCK_CURL_LOG="$root/unexpected-curl" PATH="$root/bin:$PATH" HOME="$root/home" \
		LINUX_TOOLBOX_NONINTERACTIVE=1 bash "$root/local/install.sh" >/dev/null
	diff -u "$root/expected" "$root/local.log"
	[[ ! -e $root/unexpected-curl ]]
	# shellcheck disable=SC2016
	path_line='export PATH="$HOME/.local/bin:$PATH"'
	[[ $(grep -Fxc -- "$path_line" "$root/home/.bashrc") == 1 ]]

	# A release copy (base_url pinned by release.yml) ignores same-named files next to it.
	sed 's#^base_url=.*#base_url=https://example.invalid/releases/download/v9.9.9#' install.sh >"$root/local/install.sh"
	MOCK_CURL_LOG="$root/pinned" PATH="$root/bin:$PATH" HOME="$root/home" \
		LINUX_TOOLBOX_NONINTERACTIVE=1 bash "$root/local/install.sh" >/dev/null
	diff -u "$root/expected" "$root/pinned"
	pass 'installer uses remote scripts when piped or pinned, and local scripts from a checkout'
}

test_node_installer() {
	local home="$test_dir/node" output path
	mkdir -p "$home/.nvm/versions/node/v24.20.0/bin"
	# A node already managed by nvm is not a foreign copy.
	printf '#!/usr/bin/env bash\necho v24.20.0\n' >"$home/.nvm/versions/node/v24.20.0/bin/node"
	chmod +x "$home/.nvm/versions/node/v24.20.0/bin/node"
	path="$home/.nvm/versions/node/v24.20.0/bin:$PATH"
	cat >"$home/.nvm/nvm.sh" <<'EOF'
nvm() {
	printf '%s\n' "$*" >>"$NVM_DIR/calls"
	case $1 in
	install) echo 'hidden nvm output' ;;
	alias) ;;
	version) echo 'v24.20.0' ;;
	esac
}
EOF
	output=$(HOME="$home" NVM_DIR="$home/.nvm" PATH="$path" LINUX_TOOLBOX_NONINTERACTIVE=1 \
		bash install-node.sh 2>&1)
	[[ -z $output ]]
	[[ $(readlink "$home/.nvm/versions/node/current") == "$home/.nvm/versions/node/v24.20.0" ]]
	grep -Fqx 'alias default lts/*' "$home/.nvm/calls"

	mkdir -p "$home/.nvm/alias"
	echo 22 >"$home/.nvm/alias/default"
	rm "$home/.nvm/calls"
	output=$(HOME="$home" NVM_DIR="$home/.nvm" PATH="$path" LINUX_TOOLBOX_NONINTERACTIVE=1 \
		bash install-node.sh 2>&1)
	grep -Fq 'Kept the nvm default 22' <<<"$output"
	if grep -Fq 'alias default' "$home/.nvm/calls"; then
		return 1
	fi

	# A foreign Node.js is kept only when it has its own npx.
	mkdir -p "$home/system"
	printf '#!/usr/bin/env bash\necho v18.19.1\n' >"$home/system/node"
	chmod +x "$home/system/node"
	rm "$home/.nvm/calls"
	HOME="$home" NVM_DIR="$home/.nvm" PATH="$home/system:$PATH" LINUX_TOOLBOX_NONINTERACTIVE=1 \
		bash install-node.sh >/dev/null 2>&1
	grep -Fq 'install --lts' "$home/.nvm/calls"
	cp "$home/system/node" "$home/system/npx"
	output=$(HOME="$home" NVM_DIR="$home/.nvm" PATH="$home/system:$PATH" LINUX_TOOLBOX_NONINTERACTIVE=1 \
		bash install-node.sh 2>&1)
	grep -Fq 'Kept the existing Node.js' <<<"$output"
	pass 'Node installer selects LTS quietly, keeps a custom nvm default unless confirmed, and replaces a Node.js without npx'
}

test_dependency_output() (
	local output log="$test_dir/packages"
	# shellcheck source=./install-dependencies.sh
	source install-dependencies.sh
	export PKG_MGR=apt
	# shellcheck disable=SC2317,SC2329
	apt-get() {
		printf '%s\n' "${!#}" >>"$log"
		echo 'hidden package-manager output'
	}
	output=$(pkg_install git gh)
	grep -Fq 'Installing or updating git...' <<<"$output"
	grep -Fq 'git installed' <<<"$output"
	grep -Fq 'Installing or updating gh...' <<<"$output"
	grep -Fq 'gh installed' <<<"$output"
	if grep -Fq 'hidden package-manager output' <<<"$output"; then
		return 1
	fi
	diff -u <(printf '%s\n' git gh) "$log"

	# apt-get update waits while another apt holds the package lists lock.
	# shellcheck disable=SC2317,SC2329
	sleep() { :; }
	# shellcheck disable=SC2317,SC2329
	apt-get() {
		printf '%s\n' "$*" >>"$log.update"
		(($(wc -l <"$log.update") > 2)) || {
			echo 'E: Could not get lock /var/lib/apt/lists/lock' >&2
			return 100
		}
	}
	apt_update
	[[ $(wc -l <"$log.update") == 3 ]]
	pass 'system dependencies report each package, hide successful manager output, and wait for the apt lock'
)

test_ubuntu_cleanup() {
	local root="$test_dir/cleanup" fs command
	fs="$root/fs"
	mkdir -p "$root/bin" "$fs/etc/update-motd.d" "$fs/etc/apt/preferences.d" "$fs/etc/cloud" \
		"$fs/home/u/snap" "$fs/home/u/keep" "$fs/root/snap" "$fs/snap/core" "$fs/var/lib/snapd"
	echo 'ID=ubuntu' >"$fs/etc/os-release"
	touch "$fs/etc/update-motd.d/50-motd-news" "$fs/etc/update-motd.d/00-header"
	cat >"$root/bin/mock" <<'EOF'
#!/usr/bin/env bash
printf '%s %s\n' "${0##*/}" "$*" >>"$CLEANUP_LOG"
case ${0##*/} in
snap) [[ $1 != list ]] || printf '%s\n' Name core lxd snapd | grep -vxFf <(sed -n 's/^snap remove --purge //p' "$CLEANUP_LOG") ;;
dpkg-query)
	[[ ${!#} == ubuntu-wsl ]] || exit 1
	echo 'install ok installed'
	;;
apt-cache) printf '%s\n' ubuntu-wsl '  Depends: curl' ' |Depends: vim' '  Depends: nano' '  Depends: <editor>' '  Recommends: lsof' ;;
cloud-id) echo none ;;
esac
exit 0
EOF
	chmod +x "$root/bin/mock"
	for command in snap systemctl dpkg-query apt-cache apt-mark apt-get cloud-id; do
		ln -s mock "$root/bin/$command"
	done
	# Run as a regular user, with every system path moved into the test folder in one pass.
	sed -E -e 's/EUID -ne 0/EUID -lt 0/' -e "s#(^|[[:space:]\">(])/(etc|var|home|root|snap)\b#\1$fs/\2#g" \
		ubuntu-cleanup.sh >"$root/cleanup.sh"
	# A system path the rewrite missed would hit the real machine.
	if sed "s#$fs/##g" "$root/cleanup.sh" | grep -En '(^|[^[:alnum:]_}.-])/(etc|var|home|root|snap)\b'; then
		return 1
	fi
	CLEANUP_LOG="$root/log" PATH="$root/bin:$PATH" bash "$root/cleanup.sh" >/dev/null
	[[ -d $fs/home/u/keep && ! -e $fs/home/u/snap && ! -e $fs/root/snap && ! -e $fs/snap && ! -e $fs/var/lib/snapd ]]
	[[ -e $fs/etc/update-motd.d/00-header && ! -e $fs/etc/update-motd.d/50-motd-news ]]
	[[ $(grep -c '^snap remove' "$root/log") == 3 && $(grep '^snap remove' "$root/log" | tail -n 1) == 'snap remove --purge snapd' ]]
	grep -Fqx 'apt-mark manual curl vim nano' "$root/log"
	grep -Fqx 'apt-get -o DPkg::Lock::Timeout=300 purge -y snapd apport multipath-tools kdump-tools' "$root/log"
	[[ -e $fs/etc/apt/preferences.d/nosnap.pref && -e $fs/etc/cloud/cloud-init.disabled ]]
	pass 'Ubuntu cleanup removes only snap folders, guards WSL packages, and pins snapd away'
}

test_release_flow() {
	local root="$test_dir/release-flow" first second profile output
	mkdir -p "$root/bin" "$root/home"
	cat >"$root/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$GH_LOG"
echo 'hidden gh output'
EOF
	chmod +x "$root/bin/gh"
	first=$(GH_LOG="$root/gh.log" PATH="$root/bin:$PATH" HOME="$root/home" bash install-release-flow.sh)
	second=$(GH_LOG="$root/gh.log" PATH="$root/bin:$PATH" HOME="$root/home" bash install-release-flow.sh)
	grep -Fq 'Run source ~/.bashrc' <<<"$first"
	[[ -z $second ]]
	if grep -Fq 'hidden gh output' <<<"$first"; then
		return 1
	fi
	# shellcheck disable=SC2016
	profile='case " ${MAKEFILES:-} " in *" $HOME/.config/make/release-flow.mk "*) ;; *) export MAKEFILES="$HOME/.config/make/release-flow.mk${MAKEFILES:+ $MAKEFILES}" ;; esac'
	[[ $(grep -Fxc -- "$profile" "$root/home/.bashrc") == 1 ]]
	MAKEFILES="$root/home/.config/make/release-flow.mk" make --directory="$root" \
		--no-print-directory --dry-run start-dev | grep -Fqx 'gh release-flow "start-dev"'
	MAKEFILES="$root/home/.config/make/release-flow.mk" make --directory="$root" \
		--no-print-directory --dry-run rf-upgrade | grep -Fqx 'gh release-flow "upgrade"'
	# Project Makefiles that read MAKEFILE_LIST do not see the global file.
	# shellcheck disable=SC2016
	printf 'where:\n\t@echo $(firstword $(MAKEFILE_LIST))\n' >"$root/Makefile"
	[[ $(MAKEFILES="$root/home/.config/make/release-flow.mk" make --directory="$root" --no-print-directory where) == Makefile ]]
	# The file v1.10.0 wrote is replaced without asking, so the new targets appear.
	printf '%s\n' '.PHONY: start-dev open-pr merge-release' '' 'start-dev open-pr merge-release:' \
		$'\t@gh release-flow "$@"' >"$root/home/.config/make/release-flow.mk"
	GH_LOG="$root/gh.log" PATH="$root/bin:$PATH" HOME="$root/home" LINUX_TOOLBOX_NONINTERACTIVE=1 \
		bash install-release-flow.sh >/dev/null
	grep -Fq 'rf-version rf-upgrade:' "$root/home/.config/make/release-flow.mk"
	printf 'custom:\n' >"$root/home/.config/make/release-flow.mk"
	output=$(GH_LOG="$root/gh.log" PATH="$root/bin:$PATH" HOME="$root/home" \
		LINUX_TOOLBOX_NONINTERACTIVE=1 bash install-release-flow.sh)
	grep -Fq 'Kept the existing' <<<"$output"
	[[ $(<"$root/home/.config/make/release-flow.mk") == custom: ]]
	pass 'release-flow Make targets work, notice once, and keep a custom Make file'
}

test_ai_tools() {
	local root="$test_dir/ai" output path begin end claude_md settings hook status=0
	# Hide real agents installed under the developer's home directory.
	path=$(tr ':' '\n' <<<"$PATH" | grep -Fv "$HOME/" | paste -sd :)
	path="$root/bin:$path"
	mkdir -p "$root/bin" "$root/home"
	cat >"$root/bin/curl" <<'EOF'
#!/usr/bin/env bash
case $* in
*claude-code-releases/latest*) exec echo 1.2.3 ;;
*codex/channels/latest*) exec printf '{\n  "tag_name": "rust-v1.2.3"\n}\n' ;;
*claude.ai/install.sh*) command=claude ;;
*chatgpt.com/codex/install.sh*) command=codex ;;
*) exit 1 ;;
esac
printf '%s\n' "$command" >>"$INSTALLER_LOG"
mkdir -p "$HOME/.local/bin"
cat >"$HOME/.local/bin/$command" <<'SCRIPT'
#!/usr/bin/env bash
[[ $* != --version ]] || exec echo "${0##*/} 1.2.3"
printf '%s %s\n' "${0##*/}" "$*" >>"$AI_LOG"
SCRIPT
chmod +x "$HOME/.local/bin/$command"
printf '%s\n' '#!/usr/bin/env bash' 'echo "hidden installer output"'
EOF
	cat >"$root/bin/npx" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$NPX_LOG"
echo 'hidden skills banner'
EOF
	printf '#!/usr/bin/env bash\nexit 0\n' >"$root/bin/noop"
	chmod +x "$root/bin/curl" "$root/bin/npx" "$root/bin/noop"
	for command in actionlint bwrap rg shellcheck shfmt; do
		ln -s noop "$root/bin/$command"
	done
	# The installer edits Claude settings with jq, so the test needs the real one.
	ln -s "$(command -v jq)" "$root/bin/jq"

	output=$(AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh)
	for tool in bubblewrap 'Claude Code 1.2.3' 'Codex 1.2.3' Ponytail; do
		grep -Fq "$tool installed" <<<"$output"
	done
	if grep -Eq 'hidden|Marketplace|████|Tip:' <<<"$output"; then
		return 1
	fi
	[[ -s $root/npx.log ]]
	[[ $(grep -Fvc -- '--global' "$root/npx.log") == 0 ]]
	[[ $(grep -Fv context-handoff "$root/npx.log" | grep -Fvc -- '--agent codex claude-code') == 0 ]]
	grep -Eq -- 'context-handoff#[0-9a-f]{40} --global --agent codex --skill' "$root/npx.log"
	# Every skill source is pinned to a commit.
	[[ $(grep -Evc -- '^--yes skills add [^ ]+#[0-9a-f]{40} ' "$root/npx.log") == 0 ]]
	[[ $(grep -Fvc -- '--yes' "$root/npx.log") == 0 ]]
	grep -Fq 'claude plugin install ponytail@linux-toolbox --yes' "$root/agents.log"
	grep -Fq 'codex plugin add ponytail@ponytail' "$root/agents.log"
	[[ $(wc -l <"$root/home/.codex/AGENTS.md") == 11 ]]
	[[ $(wc -l <"$root/home/.claude/CLAUDE.md") == 11 ]]
	settings="$root/home/.claude/settings.json"
	[[ $(jq -c '[.permissions.deny, .permissions.ask, (.hooks.PreToolUse | length), (.hooks.PostToolUse | length)]' "$settings") == '[["Bash(git push:*)","Bash(git tag:*)","Bash(gh release create:*)"],["Bash(git commit:*)","Bash(gh pr merge:*)"],1,1]' ]]
	# The lint hook reports shell findings with exit 2 and stays quiet for clean or unrelated files.
	hook="$root/home/.claude/hooks/linux-toolbox-lint.sh"
	shellcheck "$hook"
	# shellcheck disable=SC2016
	printf '#!/bin/bash\necho $1\n' | tee "$root/bad" >"$root/notes.txt"
	# shellcheck disable=SC2016
	printf '#!/bin/bash\necho "$1"\n' >"$root/good.sh"
	jq -n --arg f "$root/bad" '{tool_input: {file_path: $f}}' | bash "$hook" 2>"$root/lint.err" || status=$?
	[[ $status == 2 ]]
	grep -Fq SC2086 "$root/lint.err"
	sed -i 1d "$root/notes.txt"
	for file in good.sh notes.txt; do
		jq -n --arg f "$root/$file" '{tool_input: {file_path: $f}}' | bash "$hook"
	done
	# Settings that are not valid JSON are left alone.
	printf 'not json\n' >"$settings"
	output=$(AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh claude 2>&1)
	grep -Fq 'settings.json is not valid JSON; Claude Code settings left unchanged' <<<"$output"
	[[ $(<"$settings") == 'not json' ]]
	pass 'AI tools stay themed, global, non-interactive, and write concise guidance'

	rm -rf "${root:?}/home" "$root/agents.log" "$root/npx.log"
	mkdir -p "$root/home/.claude"
	begin='<!-- linux-toolbox guidance: managed by install-ai-tools.sh, edits inside are replaced -->'
	end='<!-- end linux-toolbox guidance -->'
	claude_md="$root/home/.claude/CLAUDE.md"
	settings="$root/home/.claude/settings.json"
	printf '%s\n' '{"model": "opus", "permissions": {"deny": ["Bash(rm -rf:*)", "Bash(git push:*)"]},' \
		'"hooks": {"PreToolUse": [{"matcher": "Edit", "hooks": [{"type": "command", "command": "true"}]}]}}' >"$settings"
	# Own notes around a rule left loose by an older installer and an outdated managed block.
	printf '%s\n' '# My notes' \
		'- When spawning a subagent, name the exact files or line ranges and one deliverable; do quick lookups inline instead of delegating them.' \
		"$begin" '- stale rule' "$end" '# More notes' >"$claude_md"
	output=$(AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh claude)
	grep -Fq 'Claude Code 1.2.3 installed' <<<"$output"
	if cat - "$root/agents.log" "$root/npx.log" <<<"$output" | grep -Eiq 'codex|context-handoff'; then
		return 1
	fi
	[[ $(grep -Fvc -- '--agent claude-code' "$root/npx.log") == 0 ]]
	[[ ! -e $root/home/.codex ]]
	[[ $(head -n 1 "$claude_md") == '# My notes' && $(tail -n 1 "$claude_md") == '# More notes' ]]
	[[ $(grep -Fcx -- "$begin" "$claude_md") == 1 && $(grep -Fc 'When spawning a subagent' "$claude_md") == 1 ]]
	[[ $(wc -l <"$claude_md") == 13 ]]
	if grep -Fq 'stale rule' "$claude_md"; then
		return 1
	fi
	# A start marker without its end marker leaves the file untouched.
	mkdir -p "$root/home/.codex"
	printf '%s\n' "$begin" '- keep me' >"$root/home/.codex/AGENTS.md"
	AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh codex >/dev/null 2>&1
	rm -f "$root/installers.log"
	output=$(AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh claude codex 2>&1)
	grep -Fq 'AGENTS.md has a linux-toolbox start marker but no end marker' <<<"$output"
	[[ $(<"$root/home/.codex/AGENTS.md") == "$begin"$'\n- keep me' ]]
	[[ $(wc -l <"$claude_md") == 13 ]]
	grep -Fq 'Claude Code 1.2.3 is already up to date' <<<"$output"
	grep -Fq 'Codex 1.2.3 is already up to date' <<<"$output"
	if grep -Eq 'Installing or updating (Claude Code|Codex)' <<<"$output"; then
		return 1
	fi
	[[ ! -e $root/installers.log ]]
	# Own settings stay, rules are not duplicated, and repeated runs keep a single linux-toolbox hook.
	[[ $(jq -c '[.model, .permissions.deny, (.hooks.PreToolUse | length), (.hooks.PostToolUse | length)]' "$settings") == '["opus",["Bash(rm -rf:*)","Bash(git push:*)","Bash(git tag:*)","Bash(gh release create:*)"],2,1]' ]]
	jq -r '.hooks.PreToolUse[1].hooks[0].command' "$settings" >"$root/hook.sh"
	status=0
	jq -n '{tool_input: {command: "git commit -m \"feat: x\n\nCo-Authored-By: A <a@b>\""}}' |
		sh "$root/hook.sh" 2>/dev/null || status=$?
	[[ $status == 2 ]]
	jq -n '{tool_input: {command: "git commit -m \"feat: x\""}}' | sh "$root/hook.sh"
	# A user hook inside our group, or with linux-toolbox in its path, survives a re-run.
	jq '.hooks.PreToolUse[1].hooks += [{type: "command", command: "mine"}]
		| .hooks.PostToolUse += [{matcher: "Write", hooks: [{type: "command", command: "bash ~/linux-toolbox/mine.sh"}]}]' \
		"$settings" >"$root/settings.json"
	mv "$root/settings.json" "$settings"
	AI_LOG="$root/agents.log" NPX_LOG="$root/npx.log" INSTALLER_LOG="$root/installers.log" \
		PATH="$path" HOME="$root/home" bash install-ai-tools.sh claude >/dev/null
	[[ $(jq -c '[.hooks[][].hooks[].command | select(test("mine"))] | length' "$settings") == 2 ]]
	[[ $(jq -c '[.hooks[][].hooks[].command | select(test("lint\\.sh|linux-toolbox: commits"))] | length' "$settings") == 2 ]]
	pass 'AI tools install only the selected agent and skip it when up to date'
}

test_git_setup_modes() {
	local root="$test_dir/git-setup"
	mkdir -p "$root/bin" "$root/home"
	cat >"$root/bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ $* == 'config --global --get '* ]]; then
	exit 1
fi
printf 'git %s\n' "$*" >>"$SETUP_LOG"
EOF
	cat >"$root/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf 'gh %s\n' "$*" >>"$SETUP_LOG"
exit 0
EOF
	printf '#!/usr/bin/env bash\n' >"$root/bin/explorer.exe"
	chmod +x "$root/bin/git" "$root/bin/gh" "$root/bin/explorer.exe"
	printf 'Test User\ntest@example.com\n' | SETUP_LOG="$root/identity.log" \
		PATH="$root/bin:$PATH" HOME="$root/home" bash setup-git.sh identity >/dev/null
	grep -Fqx 'git config --global user.name Test User' "$root/identity.log"
	grep -Fqx 'git config --global user.email test@example.com' "$root/identity.log"
	SETUP_LOG="$root/github.log" PATH="$root/bin:$PATH" HOME="$root/home" WSL_INTEROP=1 \
		bash setup-git.sh github >/dev/null
	grep -Fqx 'gh config set browser explorer.exe' "$root/github.log"
	grep -Fqx 'gh auth setup-git --hostname github.com' "$root/github.log"
	if grep -Fq 'git config --global user.' "$root/github.log"; then
		return 1
	fi
	pass 'Git identity and GitHub authentication run independently'
}

